# Copy to .env and fill in. Never commit the real .env.
MONGO_URI=mongodb://127.0.0.1:27017/shopnest
JWT_SECRET=change-me-to-a-long-random-string
STRIPE_SECRET_KEY=sk_test_...
PORT=5000

# The storefront's address (used for CORS, Stripe return URLs and email links).
# Several origins can be separated by commas.
CLIENT_URL=http://localhost:5173

# Optional: from `stripe listen --forward-to localhost:5000/api/orders/webhook`
STRIPE_WEBHOOK_SECRET=

# Email (spec 001) — leave BREVO_API_KEY empty to switch email off.
BREVO_API_KEY=
# Sender address, verified in Brevo → Senders
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=ShopNest
# Where new-order alerts go (empty = no alerts)
STORE_NOTIFY_EMAIL=you@example.com

# Image upload (spec 002) — from Cloudinary → Settings → API Keys.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>. Empty = upload off.
CLOUDINARY_URL=
